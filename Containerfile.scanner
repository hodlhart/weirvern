# Weirvern SCAN image: Nmap + safe NSE identity scripts on top of the Python package.
#
# WHY A SEPARATE IMAGE. Scanning is executed by WEIRLINGS, not by a central Deployment: the hub
# ships this image to each unit, whose agent runs `weirvern.admin.sensor_agent`, measures its own
# Nmap at startup, and claims manual jobs from the hub queue inside the networks it declares.
# Keeping Nmap out of the detection worker means the worker carries no network scanner's
# binaries or attack surface.
#
# The identity layer is Nmap -sV plus bundled safe NSE scripts (http-title, ssl-cert,
# smb-os-discovery, snmp-sysdescr, ...). There is no template tree, no update lifecycle and no
# vulnerability verdict: nothing here invents a finding.
#
# BUILD (the tag follows the worker's; install.sh builds both):
#   podman build -t weirvern-scan:sha-<commit> -f Containerfile.scanner .
FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      nmap ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY weirvern ./weirvern
RUN pip install --no-cache-dir .

RUN useradd --system --uid 10001 --create-home weirvern
USER weirvern

# The agent, not the removed central scanner loop. deploy-weirling.sh overrides this
# with python3 anyway; a bare run still starts the sensor agent, which is the only
# process this image exists to run.
ENTRYPOINT ["python", "-m", "weirvern.admin.sensor_agent"]
