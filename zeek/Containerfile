# Weirvern Zeek sensor image.
#
# WHY A DERIVED IMAGE: Zeek 9.x core ships NO JA4 policy -- verified by grepping the
# entire /usr/local/zeek/share/zeek tree on a live pod: zero hits. TLS fingerprints live
# in a package, and a package has to be present at BUILD time.
#
# WHY THE MODULE IS VENDORED INTO THIS REPOSITORY (zeek/vendor/ja4-zeek-scripts):
#
#   * NO NETWORK FETCH AT BUILD TIME. An earlier build fetched the package with `zkg`; a
#     build that depends on a fetch can fail for reasons that have nothing to do with the
#     code, and a sensor must not depend on a fetch to come up.
#   * THE IMAGE CONTAINS EXACTLY WHAT THE REPOSITORY SHOWS. The vendored tree is reviewed
#     like every other file here, and there is no package machinery whose contents could
#     change under the build.
#   * BSD 3-Clause ONLY. The module's copyright and license text travel with it
#     (vendor/ja4-zeek-scripts/LICENSE-JA4), as the license requires.
#
#     podman build -t registry.example.com/weirvern-zeek:0.4.0 -f zeek/Containerfile zeek/
#     podman push registry.example.com/weirvern-zeek:0.4.0
#
#     cd k8s && kustomize edit set image weirvern-zeek=registry.example.com/weirvern-zeek:0.4.0
#
# Do NOT set ZEEKPATH in this image. The upstream zeek/zeek image deliberately leaves it
# unset; pinning it to share/zeek hides the builtin plugins under lib/zeek/plugins and
# Zeek dies at startup with "can't find Zeek_JavaScript/__load__.zeek". Verified by
# comparing the two images directly -- the derived one crash-looped.
FROM zeek/zeek:lts

# The module lands at the path the site policy loads: site/packages/ja4-zeek-scripts.
# The policy (k8s/zeek/weirvern-local.zeek, mounted from a ConfigMap at runtime) does
# `@load packages/ja4-zeek-scripts`, so this path is the interface between image and
# policy.
COPY vendor/ja4-zeek-scripts /usr/local/zeek/share/zeek/site/packages/ja4-zeek-scripts

# Fail the build if the module did not land where the policy expects it. Without this, a
# bad COPY path produces an image that builds fine and whose sensor then aborts at startup
# with "failed to locate script".
RUN test -f /usr/local/zeek/share/zeek/site/packages/ja4-zeek-scripts/config.zeek \
 || { echo "ERROR: the ja4 module is not present at the expected path"; exit 1; }

# Prove at BUILD time that the module LOADS as Zeek sees it -- a `zeek -e` load needs no
# capture interface. A failed load takes the whole sensor down at startup, and a module
# that loads but emits nothing is a sensor that records no fingerprints while looking
# healthy; only Zeek itself can tell the two from the file listing.
#
# THIS CHECK IS A SCRIPT, NOT AN INLINE HEREDOC. Dockerfile syntax does not support a
# line-continued RUN with `cat <<EOF` (the build fails with "unterminated heredoc"), and a
# script can also be exercised against a plain directory outside a container.
COPY verify-ja4.sh /tmp/verify-ja4.sh
RUN sh /tmp/verify-ja4.sh /usr/local/zeek/share/zeek/site/packages/ja4-zeek-scripts

# The site policy is mounted from a ConfigMap at runtime (see k8s/32-zeek.yaml), not baked
# in, so it can be changed without rebuilding this image.
